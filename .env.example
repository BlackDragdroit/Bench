# Verbindung zur PostgreSQL-Datenbank (in Coolify: interne URL der Datenbank-Ressource)
DATABASE_URL=postgres://bench:passwort@localhost:5432/bench
# Passwort für den Login
APP_PASSWORD=
# Zufälliger Wert mit mindestens 32 Zeichen, z. B. `openssl rand -hex 32`
SESSION_SECRET=
# Nur serverseitig, für die Teilesuche. Leer lassen = Teilesuche aus
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Ordner für hochgeladene Dateien (im Container: persistentes Volume)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50
PORT=3000
